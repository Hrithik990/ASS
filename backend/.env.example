# Copy this file to ".env" and put your real connection string in it
PORT=5000

# Local MongoDB example:
# MONGO_URI=mongodb://127.0.0.1:27017/recipe-sharing

# MongoDB Atlas example (replace username, password and cluster):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/recipe-sharing?retryWrites=true&w=majority
